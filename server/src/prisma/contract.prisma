// use prisma-next

enum Provider {
  @@type("pg/text@1")
  Local = "local"
  Google = "google"
  Github = "github"
}

enum MessageType {
  @@type("pg/text@1")
  Text = "text"
  Image = "image"
  Video = "video"
  Voice = "voice"
  File = "file"
}

enum VisibilityType {
  @@type("pg/text@1")
  PUBLIC = "public"
  PRIVATE = "private"
}

enum ChannelType {
  @@type("pg/text@1")
  TEXT = "text"
  VOICE = "voice"
}

model User {
  id Int @id @default(autoincrement())
  username String
  full_name String
  email String? @unique
  password_hash String?
  avatar_url String?
  email_verified Boolean @default(false)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  user_auth_provider User_Auth_Provider[]
  refreshToken RefreshToken[]
  email_verification_otps EmailVerificationOTP[]
  owned_servers Server[] @relation("ServerOwner")
  server_memberships ServerMember[]
  authored_messages Message[] @relation("MessageAuthor")
  conversation_memberships ConversationMember[]
  direct_messages DirectMessage[] @relation("DirectMessageAuthor")
  message_receipts MessageReceipt[]
}

model User_Auth_Provider {
  id Int @id @default(autoincrement())
  userId Int
  provider Provider
  provider_user_id String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
}

model EmailVerificationOTP {
  id Int @id @default(autoincrement())
  user_id Int
  otp_hash String
  expires_at TimestamptzString
  attempt_count Int @default(0)
  consumed_at TimestamptzString?
  createdAt TimestamptzString @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id Int @id @default(autoincrement())
  token_id String @unique
  user_id Int
  hash_refresh_token String
  expires_at TimestamptzString
  revoked_at TimestamptzString?

  user User @relation(fields: [user_id], references: [id])
}

model Server {
  id Int @id @default(autoincrement())
  name String
  description String?
  iconUrl String? @map("icon_url")
  visibility VisibilityType @default(PUBLIC)
  ownerId Int @map("owner_id")
  createdAt TimestamptzString @default(now()) @map("created_at")

  owner User @relation("ServerOwner", fields: [ownerId], references: [id])
  members ServerMember[]
  channels Channel[]
  roles Role[]

  @@unique([name])
  @@index([ownerId, createdAt])
}

model ServerMember {
  serverId Int @map("server_id")
  userId Int @map("user_id")
  nickname String?
  joinedAt TimestamptzString @default(now()) @map("joined_at")

  server Server @relation(fields: [serverId], references: [id])
  user User @relation(fields: [userId], references: [id])
  roleAssignments ServerMemberRole[]

  @@id([serverId, userId])
  @@index([userId])
  @@map("server_member")
}

model Channel {
  id Int @id @default(autoincrement())
  serverId Int @map("server_id")
  name String
  type ChannelType @default(TEXT)
  isPrivate Boolean @default(false)
  position Int?
  createdAt TimestamptzString @default(now()) @map("created_at")

  server Server @relation(fields: [serverId], references: [id])
  messages Message[]

  @@index([serverId])
}

model Message {
  id Int @id @default(autoincrement())
  channelId Int @map("channel_id")
  authorId Int @map("sender_id")
  replyToMessageId Int? @map("reply_to_message_id")
  content String
  createdAt TimestamptzString @default(now()) @map("created_at")
  editedAt TimestamptzString? @map("edited_at")
  deletedAt TimestamptzString? @map("deleted_at")

  channel Channel @relation(fields: [channelId], references: [id])
  author User @relation("MessageAuthor", fields: [authorId], references: [id])
  replyTo Message? @relation("MessageReplies", fields: [replyToMessageId], references: [id])
  replies Message[] @relation("MessageReplies")

  @@index([channelId])
  @@index([authorId, createdAt])
  @@index([replyToMessageId])
  @@map("channel_message")
}

model Role {
  id Int @id @default(autoincrement())
  serverId Int @map("server_id")
  name String
  color String @default("#99AAB5")
  permissions Int @default(0)
  position Int
  isDefault Boolean @default(false)

  server Server @relation(fields: [serverId], references: [id])
  members ServerMemberRole[]

  @@index([serverId])
}

model ServerMemberRole {
  id Int @id @default(autoincrement())
  serverId Int @map("server_id")
  userId Int @map("user_id")
  roleId Int @map("role_id")

  membership ServerMember @relation(fields: [serverId, userId], references: [serverId, userId])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([serverId, userId])
  @@index([roleId])
  @@map("server_member_role")
}

model Conversation {
  id Int @id @default(autoincrement())
  createdAt TimestamptzString @default(now())
  lastMessageAt TimestamptzString?

  members ConversationMember[]
  messages DirectMessage[]
}

model ConversationMember {
  conversationId Int
  userId Int
  joinedAt TimestamptzString @default(now())
  lastReadMessageId Int?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, joinedAt])
}

model DirectMessage {
  id Int @id @default(autoincrement())
  conversationId Int
  senderId Int
  content String
  messageType MessageType @default(Text)
  createdAt TimestamptzString @default(now())
  editedAt TimestamptzString?
  deletedAt TimestamptzString?
  replyToMessageId Int?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation("DirectMessageAuthor", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo DirectMessage? @relation("DirectMessageReplies", fields: [replyToMessageId], references: [id])
  replies DirectMessage[] @relation("DirectMessageReplies")
  receipts MessageReceipt[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([replyToMessageId])
}

model MessageReceipt {
  messageId Int
  userId Int
  createdAt TimestamptzString @default(now())
  deliveredAt TimestamptzString?
  seenAt TimestamptzString?

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, seenAt])
}

model LegacyVoiceSession {
  camera_enabled Boolean @default(false)
  channel_id Int
  id Int @id @default(autoincrement())
  joined_at TimestamptzString
  left_at TimestamptzString?
  microphone_enabled Boolean @default(true)
  screen_sharing Boolean @default(false)
  user_id Int
  @@control(external)
  @@map("voice_session")
}
